{
  "name": "@adapstory/student",
  "version": "0.1.0",
  "private": true,
  "prettier": "@adapstory/prettier-config",
  "scripts": {
    "dev": "next dev --turbopack --port 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "generate:api": "node scripts/generate-api.mjs",
    "generate:api:fetch": "node scripts/generate-api.mjs --fetch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:journey:preflight": "node scripts/no-mock-preflight.mjs",
    "test:e2e:journey:real": "node scripts/no-mock-preflight.mjs && playwright test e2e/student-journey.spec.ts e2e/student-accessibility.spec.ts"
  },
  "dependencies": {
    "@adapstory/block-editor": "workspace:*",
    "@adapstory/shared": "workspace:*",
    "@base-ui/react": "^1.3.0",
    "@divkitframework/divkit": "^32.41.0",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.3",
    "next-intl": "^4.9.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.0.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24",
    "zustand": "^5.0.11",
    "@adapstory/i18n": "workspace:*",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0"
  },
  "devDependencies": {
    "@adapstory/eslint-config": "workspace:*",
    "@adapstory/prettier-config": "workspace:*",
    "@adapstory/tsconfig": "workspace:*",
    "@axe-core/playwright": "^4.11.1",
    "@hey-api/openapi-ts": "^0.94.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
